---
import Orbs from './Orbs.astro';
import { t, type Lang } from '../i18n/strings';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang).process;
---

<section class="process tone" id="processo" data-tone="light" aria-labelledby="process-title">
  <Orbs set="process" />
  <div class="wrap">
    <header class="section-head">
      <h2 class="section-title" id="process-title">{s.title}</h2>
      <p class="section-intro">{s.intro}</p>
    </header>

    <ol class="steps">
      {
        s.steps.map((step, i) => (
          <li class="step">
            <span class="num" aria-hidden="true">{i + 1}</span>
            <h3 class="step-name">{step.name}</h3>
            <p class="step-desc">{step.desc}</p>
          </li>
        ))
      }
    </ol>

    <p class="loop">
      <svg viewBox="0 0 64 28" fill="none" aria-hidden="true">
        <path d="M32 14C38 4 50 2 56 6c6 4 6 12 0 16-6 4-18 2-24-8Z" stroke="var(--ameixa)" />
        <path d="M32 14C26 24 14 26 8 22c-6-4-6-12 0-16 6-4 18-2 24 8Z" stroke="var(--mare)" />
      </svg>
      {s.loop}
    </p>
  </div>
</section>

<style>
  .process {
    padding-block: var(--section);
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(24px, 3vw, 48px);
    position: relative;
  }

  /* Fio que liga as etapas */
  .steps::before {
    content: '';
    position: absolute;
    top: 28px;
    left: 28px;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, var(--agua), var(--ameixa));
  }

  .step {
    position: relative;
    display: grid;
    align-content: start;
    gap: 14px;
  }

  .num {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: 18px;
    border: 1px solid var(--fg);
    border-radius: 50%;
    background: var(--bg);
    font-size: var(--step-1);
    font-weight: 300;
    font-variant-numeric: tabular-nums;
  }

  .step-name {
    font-size: var(--step-2);
    font-weight: 350;
    line-height: 1.15;
    text-wrap: balance;
  }

  .step-desc {
    color: var(--fg-soft);
    max-width: 22rem;
    text-wrap: pretty;
  }

  .loop {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: clamp(48px, 6vw, 80px);
    font-size: var(--step-1);
    font-weight: 300;
  }

  .loop svg {
    width: 64px;
    flex: none;
    stroke-width: 1.5px;
  }

  @media (max-width: 960px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 56px;
    }

    .steps::before {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .steps {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 40px;
    }

    /* No celular, o fio desce pela lateral */
    .steps::before {
      display: block;
      top: 28px;
      bottom: 0;
      left: 28px;
      right: auto;
      width: 1px;
      height: auto;
      background: linear-gradient(180deg, var(--agua), var(--ameixa));
    }

    .step {
      padding-left: 80px;
    }

    .num {
      position: absolute;
      left: 0;
      top: 0;
      margin: 0;
    }
  }
</style>
