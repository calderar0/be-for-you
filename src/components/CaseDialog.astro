---
// Case de um cliente em tela cheia: site, identidade visual e carrosséis.
// As imagens só carregam quando o case é aberto (e cada carrossel, quando é escolhido).
import { t, type Lang } from '../i18n/strings';
import type { Project } from '../data/projects';
import { image, getSet } from '../lib/media';

interface Props {
  project: Project;
  lang: Lang;
}

const { project: p, lang } = Astro.props;
const s = t(lang).work;
const id = `case-${p.id}`;

const identity = (p.identity ?? []).flatMap((item) =>
  typeof item === 'string' ? [image(item)] : (getSet(item)?.slides.map((sl) => sl.src) ?? []),
);
const carousels = (p.carousels ?? []).map((c) => getSet(c)).filter((c) => c !== undefined);
const pages = p.site?.pages ?? [];
const mobile = p.site?.device === 'mobile';
---

<dialog class="case" id={id} data-tone="dark" aria-labelledby={`${id}-title`}>
  <div class="case-inner wrap">
    <header class="case-head">
      <div class="case-intro">
        <h2 class="case-title" id={`${id}-title`}>{p.client}</h2>
        <p class="case-sum">{p.summary[lang]}</p>
        <p class="case-meta">
          <span>{p.services.map((c) => s.categories[c]).join(', ')}</span>
          {p.own && <span>{s.own}</span>}
          <span>{p.year}</span>
        </p>
      </div>
      <button type="button" class="case-close" data-close aria-label={s.close}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6 6 18" />
        </svg>
      </button>
    </header>

    {
      carousels.length > 0 && (
        <section class="block social" aria-label={s.social}>
          <h3 class="block-title">{s.social}</h3>
          <div class="viewer">
            {carousels.map((c, ci) => (
              <div class="track" data-track={ci} hidden={ci > 0} tabindex="0" aria-label={`${s.social} ${ci + 1}`}>
                {c.slides.map((sl) => (
                  <img src={sl.src} width={c.w} height={c.h} alt="" loading="lazy" decoding="async" />
                ))}
              </div>
            ))}
            <div class="viewer-bar">
              <p class="counter" aria-live="polite" data-of={s.slideOf(0, 0).replace(/\d+/g, '#')}></p>
              <div class="arrows">
                <button type="button" class="arrow" data-dir="-1" aria-label={s.prev}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M15 6l-6 6 6 6" />
                  </svg>
                </button>
                <button type="button" class="arrow" data-dir="1" aria-label={s.next}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 6l6 6-6 6" />
                  </svg>
                </button>
              </div>
            </div>
          </div>

          {carousels.length > 1 && (
            <div class="picker" role="group" aria-label={s.pickCarousel}>
              {carousels.map((c, ci) => (
                <button type="button" class="pick" data-pick={ci} aria-pressed={String(ci === 0)}>
                  <img src={c.slides[0].thumb} alt="" loading="lazy" decoding="async" />
                  <span class="sr-only">{`${s.social} ${ci + 1}`}</span>
                </button>
              ))}
            </div>
          )}
        </section>
      )
    }

    {
      p.site && (
        <section class="block" aria-label={mobile ? s.app : s.site}>
          <h3 class="block-title">{mobile ? s.app : s.site}</h3>

          <div class:list={['site-media', mobile && 'is-mobile']}>
          {p.site.video ? (
            <div class:list={['browser', mobile && 'is-phone']}>
              <div class="browser-bar" aria-hidden="true">
                <span />
                <span />
                <span />
              </div>
              <video
                class="site-video"
                data-src={image(p.site.video)}
                poster={p.site.poster ? image(p.site.poster) : undefined}
                muted
                loop
                playsinline
                preload="none"
                aria-label={s.video}
              />
            </div>
          ) : (
            p.site.image &&
            (p.site.url ? (
              <a class="site-shot" href={p.site.url} target="_blank" rel="noopener">
                <img src={image(p.site.image)} alt="" loading="lazy" decoding="async" />
                <span class="sr-only">{s.visit}</span>
              </a>
            ) : (
              <div class="site-shot">
                <img src={image(p.site.image)} alt="" loading="lazy" decoding="async" />
              </div>
            ))
          )}

          {pages.length > 0 && (
            <div class="pages">
              <div class:list={['browser', mobile && 'is-phone']}>
                <div class="browser-bar">
                  <span aria-hidden="true" />
                  <span aria-hidden="true" />
                  <span aria-hidden="true" />
                  <p class="page-name" aria-live="polite">{pages[0].name[lang]}</p>
                </div>
                {pages.map((pg, i) => (
                  <div class="page-scroll" data-page={i} hidden={i > 0} tabindex="0" aria-label={pg.name[lang]}>
                    <img src={image(pg.full)} alt={`${p.client}: ${pg.name[lang]}`} loading="lazy" decoding="async" />
                  </div>
                ))}
              </div>
              <div class="page-picker" role="group" aria-label={s.pages}>
                {pages.map((pg, i) => (
                  <button type="button" class="page-pick" data-pick-page={i} data-name={pg.name[lang]} aria-pressed={String(i === 0)}>
                    <img src={image(pg.screen)} alt="" loading="lazy" decoding="async" />
                    <span>{pg.name[lang]}</span>
                  </button>
                ))}
              </div>
            </div>
          )}
          </div>

          {p.site.url && (
            <a class="btn" href={p.site.url} target="_blank" rel="noopener">
              {s.visit}
            </a>
          )}
        </section>
      )
    }

    {
      identity.length > 0 && (
        <section class="block" aria-label={s.identity}>
          <h3 class="block-title">{s.identity}</h3>
          <div class:list={['id-grid', identity.length > 2 && 'is-many']}>
            {identity.map((src) => (
              <img src={src} alt="" loading="lazy" decoding="async" />
            ))}
          </div>
        </section>
      )
    }
  </div>
</dialog>

<style>
  .case {
    width: 100%;
    max-width: 100%;
    height: 100%;
    max-height: 100%;
    margin: 0;
    padding: 0;
    border: 0;
    background: var(--bg);
    color: var(--fg);
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .case[open] {
    animation: case-in 0.5s var(--ease);
  }

  .case::backdrop {
    background: rgb(21 4 42 / 0.6);
  }

  @keyframes case-in {
    from {
      opacity: 0;
      transform: translateY(24px);
    }
  }

  .case-inner {
    display: grid;
    gap: clamp(48px, 6vw, 80px);
    padding-block: clamp(28px, 4vw, 56px) clamp(64px, 8vw, 112px);
  }

  .case-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
  }

  .case-intro {
    display: grid;
    gap: 16px;
    max-width: 44rem;
  }

  .case-title {
    font-size: var(--step-4);
    font-weight: 300;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .case-sum {
    color: var(--fg-soft);
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .case-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 24px;
    color: var(--accent);
  }

  .case-close {
    position: sticky;
    top: 0;
    display: grid;
    place-items: center;
    flex: none;
    width: 52px;
    height: 52px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--bg);
    cursor: pointer;
    transition: border-color 0.25s;
  }

  .case-close:hover {
    border-color: var(--fg);
  }

  .case-close svg {
    width: 22px;
    height: 22px;
  }

  .block {
    display: grid;
    gap: 24px;
    justify-items: start;
  }

  .block-title {
    font-size: var(--step-2);
    font-weight: 300;
  }

  /* Visualizador: os slides passam para o lado, como no Instagram. */
  .viewer {
    width: 100%;
    display: grid;
    gap: 16px;
  }

  .track {
    display: flex;
    gap: 14px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    padding-bottom: 4px;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .track[hidden] {
    display: none;
  }

  .track img {
    flex: none;
    height: clamp(320px, 62vh, 640px);
    width: auto;
    max-width: 86vw;
    object-fit: contain;
    border-radius: 14px;
    scroll-snap-align: start;
    background: color-mix(in srgb, var(--nevoa) 10%, transparent);
  }

  .viewer-bar {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
  }

  .counter {
    color: var(--fg-soft);
    font-variant-numeric: tabular-nums;
  }

  .arrows {
    display: flex;
    gap: 10px;
  }

  .arrow {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: none;
    cursor: pointer;
    transition:
      border-color 0.25s,
      opacity 0.25s;
  }

  .arrow:hover {
    border-color: var(--fg);
  }

  .arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  .arrow svg {
    width: 22px;
    height: 22px;
  }

  .picker {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    max-width: 100%;
    padding: 4px;
    scrollbar-width: thin;
  }

  .pick {
    flex: none;
    width: 84px;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 12px;
    background: none;
    cursor: pointer;
    opacity: 0.55;
    transition:
      opacity 0.25s,
      border-color 0.25s;
  }

  .pick img {
    width: 100%;
    border-radius: 10px;
  }

  .pick:hover {
    opacity: 0.85;
  }

  .pick[aria-pressed='true'] {
    opacity: 1;
    border-color: var(--agua);
    padding: 3px;
  }

  /* Moldura de navegador para o vídeo e as páginas do site. */
  .browser {
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 16px;
    background: #fff;
  }

  .browser-bar {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 38px;
    padding: 0 16px;
    background: color-mix(in srgb, var(--nevoa) 16%, var(--bg));
  }

  .browser-bar span {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--nevoa) 45%, transparent);
  }

  .page-name {
    margin-left: auto;
    color: var(--fg-soft);
    font-size: 0.88rem;
  }

  .site-video {
    display: block;
    width: 100%;
    aspect-ratio: 1280 / 800;
    background: #fff;
  }

  .pages {
    display: grid;
    gap: 16px;
    width: 100%;
  }

  .site-media {
    display: grid;
    gap: 24px;
    width: 100%;
  }

  /* Projetos para celular: vídeo e páginas lado a lado, em molduras de celular. */
  .site-media.is-mobile {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 380px));
    align-items: start;
    gap: 32px;
  }

  .is-mobile .pages {
    width: auto;
  }

  .browser.is-phone {
    border: 10px solid color-mix(in srgb, var(--nevoa) 28%, #241040);
    border-radius: 42px;
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.6);
  }

  .is-phone .browser-bar {
    display: none;
  }

  .is-phone .site-video {
    aspect-ratio: 440 / 880;
  }

  .is-phone .page-scroll {
    height: min(72vh, 700px);
  }

  .is-mobile .page-pick {
    width: 92px;
  }

  /* A página inteira rola dentro da moldura, como no navegador. */
  .page-scroll {
    height: min(70vh, 720px);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: #fff;
  }

  .page-scroll[hidden] {
    display: none;
  }

  .page-scroll img {
    width: 100%;
  }

  .page-picker {
    display: flex;
    gap: 12px;
    overflow-x: auto;
    padding: 4px;
  }

  .page-pick {
    flex: none;
    display: grid;
    gap: 8px;
    width: 168px;
    padding: 6px;
    border: 1px solid transparent;
    border-radius: 12px;
    background: none;
    cursor: pointer;
    text-align: left;
    opacity: 0.6;
    transition:
      opacity 0.25s,
      border-color 0.25s;
  }

  .page-pick img {
    width: 100%;
    border-radius: 8px;
  }

  .page-pick span {
    color: var(--fg-soft);
    font-size: 0.9rem;
  }

  .page-pick:hover {
    opacity: 0.85;
  }

  .page-pick[aria-pressed='true'] {
    opacity: 1;
    border-color: var(--agua);
  }

  .site-shot {
    display: block;
    width: 100%;
    overflow: hidden;
    border-radius: 18px;
  }

  .site-shot img {
    width: 100%;
  }

  .id-grid {
    display: grid;
    gap: 16px;
    width: 100%;
  }

  .id-grid.is-many {
    grid-template-columns: repeat(auto-fill, minmax(min(220px, 100%), 1fr));
  }

  .id-grid img {
    width: 100%;
    border-radius: 14px;
  }

  @media (max-width: 640px) {
    .case-close {
      width: 44px;
      height: 44px;
    }

    .track img {
      height: auto;
      width: 84vw;
    }
  }
</style>

<script>
  const openers = document.querySelectorAll<HTMLButtonElement>('[data-open]');
  let lastOpener: HTMLElement | null = null;

  openers.forEach((btn) =>
    btn.addEventListener('click', () => {
      const dialog = document.getElementById(btn.dataset.open!) as HTMLDialogElement | null;
      if (!dialog) return;
      lastOpener = btn;
      dialog.showModal();
      dialog.scrollTop = 0;
      document.documentElement.style.overflow = 'hidden';
      dialog.dispatchEvent(new Event('case:open'));
    }),
  );

  document.querySelectorAll<HTMLDialogElement>('dialog.case').forEach((dialog) => {
    dialog.addEventListener('close', () => {
      document.documentElement.style.overflow = '';
      lastOpener?.focus();
    });
    dialog.querySelector('[data-close]')?.addEventListener('click', () => dialog.close());
    // Clique fora do conteúdo (no fundo do diálogo) fecha.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    // Vídeo do site: só carrega quando o case abre, e pausa ao fechar.
    const video = dialog.querySelector<HTMLVideoElement>('video[data-src]');
    if (video) {
      dialog.addEventListener('case:open', () => {
        if (!video.src) video.src = video.dataset.src!;
        if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) video.play().catch(() => {});
      });
      dialog.addEventListener('close', () => video.pause());
    }

    // Páginas do site: a miniatura escolhida abre a página inteira na moldura.
    const pageViews = [...dialog.querySelectorAll<HTMLElement>('.page-scroll')];
    const pagePicks = [...dialog.querySelectorAll<HTMLButtonElement>('.page-pick')];
    const pageName = dialog.querySelector<HTMLElement>('.page-name');
    pagePicks.forEach((pick) =>
      pick.addEventListener('click', () => {
        const i = Number(pick.dataset.pickPage);
        pageViews.forEach((v, j) => (v.hidden = j !== i));
        pagePicks.forEach((pk, j) => pk.setAttribute('aria-pressed', String(j === i)));
        pageViews[i].scrollTop = 0;
        if (pageName) pageName.textContent = pick.dataset.name!;
      }),
    );

    const tracks = [...dialog.querySelectorAll<HTMLElement>('.track')];
    if (!tracks.length) return;
    const counter = dialog.querySelector<HTMLElement>('.counter')!;
    const [prev, next] = [...dialog.querySelectorAll<HTMLButtonElement>('.arrow')];
    const picks = [...dialog.querySelectorAll<HTMLButtonElement>('.pick')];
    const template = counter.dataset.of!;
    let active = tracks[0];

    const slides = () => [...active.querySelectorAll<HTMLImageElement>('img')];
    const current = () => {
      const left = active.scrollLeft;
      let best = 0;
      slides().forEach((img, i) => {
        if (Math.abs(img.offsetLeft - active.offsetLeft - left) < Math.abs(slides()[best].offsetLeft - active.offsetLeft - left)) best = i;
      });
      return best;
    };
    const update = () => {
      const i = current();
      const n = slides().length;
      let k = 0;
      counter.textContent = template.replace(/#/g, () => String(k++ === 0 ? i + 1 : n));
      prev.disabled = active.scrollLeft <= 2;
      next.disabled = active.scrollLeft + active.clientWidth >= active.scrollWidth - 2;
    };
    const go = (dir: number) => {
      const target = slides()[Math.min(Math.max(current() + dir, 0), slides().length - 1)];
      active.scrollTo({ left: target.offsetLeft - active.offsetLeft, behavior: 'smooth' });
    };

    tracks.forEach((tr) => tr.addEventListener('scroll', () => requestAnimationFrame(update), { passive: true }));
    prev.addEventListener('click', () => go(-1));
    next.addEventListener('click', () => go(1));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(1);
      if (e.key === 'ArrowLeft') go(-1);
    });
    picks.forEach((pick) =>
      pick.addEventListener('click', () => {
        const i = Number(pick.dataset.pick);
        tracks.forEach((tr, j) => (tr.hidden = j !== i));
        picks.forEach((pk, j) => pk.setAttribute('aria-pressed', String(j === i)));
        active = tracks[i];
        active.scrollLeft = 0;
        update();
      }),
    );
    dialog.addEventListener('case:open', () => requestAnimationFrame(update));
  });
</script>
