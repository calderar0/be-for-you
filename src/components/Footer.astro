---
import Wordmark from './Wordmark.astro';
import { t, paths, type Lang } from '../i18n/strings';
import { site } from '../data/site';

interface Props {
  lang: Lang;
  alternate: string;
}

const { lang, alternate } = Astro.props;
const s = t(lang);
const hasAnalytics = Boolean(site.analytics.ga4 || site.analytics.metaPixel);
---

<footer class="footer tone" data-tone="dark">
  <div class="wrap">
    <a href="#top" class="f-word" aria-label={s.footer.top}>
      <Wordmark class="f-wordmark" />
    </a>
    <div class="f-row">
      <p>© {new Date().getFullYear()} Be For You. {s.footer.rights}</p>
      <ul class="f-links">
        <li><a class="link" href={paths[lang].privacy}>{s.footer.privacy}</a></li>
        {
          hasAnalytics && (
            <li>
              <button type="button" class="link f-btn" data-consent-open>
                {s.footer.cookies}
              </button>
            </li>
          )
        }
        <li><a class="link" href={alternate} lang={lang === 'pt' ? 'en' : 'pt-BR'}>{s.nav.otherLang}</a></li>
      </ul>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-block: clamp(48px, 6vw, 80px) 40px;
    border-top: 1px solid var(--line);
  }

  .f-word {
    display: block;
    color: var(--fg);
  }

  .f-word :global(.f-wordmark) {
    width: 100%;
    height: auto;
    stroke-width: 1.4px;
  }

  .f-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 16px 32px;
    margin-top: clamp(32px, 4vw, 56px);
    color: var(--fg-soft);
    font-size: 0.92rem;
  }

  .f-links {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 28px;
  }

  .f-btn {
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
    color: inherit;
    font-size: inherit;
  }
</style>
