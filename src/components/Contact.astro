---
import Orbs from './Orbs.astro';
// Contato sem servidor: o formulário monta a mensagem e abre o WhatsApp ou o e-mail.
import Signature from './Signature.astro';
import { t, type Lang } from '../i18n/strings';
import { site, whatsappLink } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang).contact;
const callMessage = t(lang).hero.callMessage;
---

<section class="contact tone" id="contato" data-tone="dark" aria-labelledby="contact-title">
  <Orbs set="contact" />
  <div class="wrap contact-grid">
    <div class="c-main">
      <header class="section-head">
        <h2 class="section-title" id="contact-title">{s.title}</h2>
        <p class="section-intro">{s.intro}</p>
      </header>

      <form
        class="form"
        novalidate
        data-wa={site.whatsapp}
        data-email={site.email}
        data-greeting={s.greeting}
        data-interest={s.interest}
        data-subject={s.subject}
      >
        <div class="field">
          <label for="c-name">{s.name}</label>
          <input id="c-name" name="name" type="text" autocomplete="name" required aria-describedby="c-error" />
        </div>
        <div class="field">
          <label for="c-service">{s.service}</label>
          <div class="select">
            <select id="c-service" name="service">
              {s.serviceOptions.map((o) => <option>{o}</option>)}
            </select>
          </div>
        </div>
        <div class="field field--full">
          <label for="c-message">{s.message}</label>
          <textarea id="c-message" name="message" rows="4" aria-describedby="c-hint"></textarea>
          <p class="hint" id="c-hint">{s.messageHint}</p>
        </div>
        <p class="error field--full" id="c-error" role="alert" hidden>{s.required}</p>
        <div class="form-actions field--full">
          <button class="btn" type="submit" value="whatsapp">
            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path
                d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2a8.2 8.2 0 0 1-4.2-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.3-.4.2-.4.7-1.3.1-.2 0-.3 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"
              ></path>
            </svg>
            {s.sendWhatsapp}
          </button>
          <button class="btn btn--ghost" type="submit" value="email">{s.sendEmail}</button>
        </div>
      </form>
    </div>

    <aside class="c-side">
      <Signature mode="finale" class="c-sig" />
      <div class="direct">
        <p class="direct-title">{s.direct}</p>
        <a class="direct-link" href={whatsappLink(callMessage)} target="_blank" rel="noopener">{site.whatsappDisplay}</a>
        <a class="direct-link" href={`mailto:${site.email}`}>{site.email}</a>
        <a class="link" href={whatsappLink(callMessage)} target="_blank" rel="noopener">{s.schedule}</a>
      </div>
    </aside>
  </div>
</section>

<style>
  .contact {
    padding-block: var(--section) clamp(64px, 8vw, 120px);
  }

  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: clamp(48px, 7vw, 120px);
    align-items: start;
  }

  .form {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 28px 24px;
  }

  .field {
    display: grid;
    gap: 10px;
  }

  .field--full {
    grid-column: 1 / -1;
  }

  label {
    color: var(--fg-soft);
    font-size: 0.95rem;
  }

  input,
  select,
  textarea {
    width: 100%;
    min-height: 54px;
    padding: 14px 0;
    border: 0;
    border-bottom: 1px solid var(--line);
    border-radius: 0;
    background: transparent;
    font-size: var(--step-1);
    font-weight: 300;
    transition: border-color 0.25s;
    appearance: none;
  }

  textarea {
    resize: vertical;
    min-height: 120px;
    line-height: 1.5;
  }

  input:hover,
  select:hover,
  textarea:hover {
    border-bottom-color: var(--fg-soft);
  }

  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: none;
    border-bottom-color: var(--accent);
    box-shadow: 0 1px 0 0 var(--accent);
  }

  input[aria-invalid='true'] {
    border-bottom-color: #f0a3b8;
  }

  .select {
    position: relative;
  }

  .select::after {
    content: '';
    position: absolute;
    right: 4px;
    top: 50%;
    width: 8px;
    height: 8px;
    border-right: 1px solid currentColor;
    border-bottom: 1px solid currentColor;
    transform: translateY(-70%) rotate(45deg);
    pointer-events: none;
  }

  select {
    cursor: pointer;
    padding-right: 28px;
  }

  select option {
    background: var(--noite);
    color: #f3f0fa;
  }

  .hint {
    color: var(--fg-soft);
    font-size: 0.88rem;
    opacity: 0.85;
  }

  .error {
    color: #f0a3b8;
  }

  .form-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 8px;
  }

  .c-side {
    display: grid;
    gap: 40px;
    position: sticky;
    top: 120px;
  }

  .c-side :global(.c-sig) {
    aspect-ratio: 2 / 1;
    width: 100%;
  }

  .direct {
    display: grid;
    gap: 8px;
    justify-items: start;
  }

  .direct-title {
    color: var(--fg-soft);
    margin-bottom: 4px;
  }

  .direct-link {
    font-size: var(--step-2);
    font-weight: 300;
    line-height: 1.25;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .direct-link:hover {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.2em;
  }

  .direct .link {
    margin-top: 12px;
  }

  @media (max-width: 900px) {
    .contact-grid {
      grid-template-columns: minmax(0, 1fr);
    }

    .c-side {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .form {
      grid-template-columns: minmax(0, 1fr);
    }

    .form-actions .btn {
      flex: 1 1 100%;
    }
  }
</style>

<script>
  const form = document.querySelector<HTMLFormElement>('.contact .form');
  if (form) {
    const d = form.dataset;
    const name = form.querySelector<HTMLInputElement>('#c-name')!;
    const error = form.querySelector<HTMLElement>('#c-error')!;

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const via = (e.submitter as HTMLButtonElement | null)?.value ?? 'whatsapp';
      const data = new FormData(form);
      const who = String(data.get('name') ?? '').trim();

      if (!who) {
        name.setAttribute('aria-invalid', 'true');
        error.hidden = false;
        name.focus();
        return;
      }
      name.removeAttribute('aria-invalid');
      error.hidden = true;

      const message = String(data.get('message') ?? '').trim();
      const text = [`${d.greeting} ${who}.`, `${d.interest}: ${data.get('service')}.`, message].filter(Boolean).join('\n\n');

      const url =
        via === 'email'
          ? `mailto:${d.email}?subject=${encodeURIComponent(d.subject!)}&body=${encodeURIComponent(text)}`
          : `https://wa.me/${d.wa}?text=${encodeURIComponent(text)}`;
      window.open(url, via === 'email' ? '_self' : '_blank', 'noopener');
    });
  }
</script>
