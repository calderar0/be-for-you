---
// Assinatura visual: esferas (WebGL) ou fio (SVG). A escolhida é definida em <html data-signature>.
interface Props {
  mode: 'hero' | 'finale';
  class?: string;
}

const { mode, class: className } = Astro.props;
const vb = mode === 'hero' ? { w: 1000, h: 640 } : { w: 1000, h: 500 };
const id = `sig-${mode}`;
// Desenho inicial do fio (estado aberto), útil também sem JavaScript.
const a = `M0 ${vb.h * 0.08}C310 ${vb.h * 0.08} 350 ${vb.h / 2} 500 ${vb.h / 2}C650 ${vb.h / 2} 690 ${vb.h * 0.92} 1000 ${vb.h * 0.92}`;
const b = `M0 ${vb.h * 0.92}C310 ${vb.h * 0.92} 350 ${vb.h / 2} 500 ${vb.h / 2}C650 ${vb.h / 2} 690 ${vb.h * 0.08} 1000 ${vb.h * 0.08}`;
---

<div class:list={['sig', `sig--${mode}`, className]} aria-hidden="true">
  <div class="sig-esferas">
    <svg class="sig-static" viewBox="0 0 1000 500">
      <defs>
        <linearGradient id={`${id}-g`} x1="0" x2="1">
          <stop offset="0.25" stop-color="#88bfbf" />
          <stop offset="0.75" stop-color="#7b5da6" />
        </linearGradient>
      </defs>
      <path
        fill={`url(#${id}-g)`}
        d="M300 60a190 190 0 1 1 0 380 190 190 0 0 1 0-380Zm400 0a190 190 0 1 1 0 380 190 190 0 0 1 0-380ZM470 160q30 90 60 0v180q-30-90-60 0Z"
      ></path>
    </svg>
    <canvas class="spheres" data-mode={mode}></canvas>
  </div>
  <svg class="threads" data-mode={mode} viewBox={`0 0 ${vb.w} ${vb.h}`} preserveAspectRatio="none" fill="none">
    <path d={a} stroke="var(--agua)"></path>
    <path d={b} stroke="var(--ameixa)"></path>
  </svg>
</div>

<style>
  .sig {
    position: relative;
    pointer-events: none;
  }

  .sig-esferas,
  .threads {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .sig-static,
  .spheres {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .sig-static {
    object-fit: contain;
  }

  .spheres {
    opacity: 0;
    transition: opacity 1.2s var(--ease) 0.2s;
  }

  .spheres:global(.is-live) {
    opacity: 1;
  }

  .threads {
    overflow: visible;
    stroke-width: 2px;
    stroke-linecap: round;
  }

  .threads path {
    vector-effect: non-scaling-stroke;
  }

  :global(html[data-signature='fio']) .sig-esferas,
  :global(html[data-signature='esferas']) .threads {
    display: none;
  }
</style>
