---
// "BE FOR YOU" com as letras monolineares da marca.
import { layout } from '../lib/glyphs';

interface Props {
  class?: string;
  stroke?: number;
}

const { class: className, stroke = 1.5 } = Astro.props;
const { placed, width } = layout('BE FOR YOU');
const pad = 4;
---

<svg
  class={className}
  viewBox={`${-pad} ${-pad} ${width + pad * 2} ${100 + pad * 2}`}
  fill="none"
  stroke="currentColor"
  stroke-width={stroke}
  stroke-linecap="round"
  role="img"
  aria-label="Be For You"
>
  {
    placed.map((p) =>
      p.glyph.circle ? (
        <circle cx={p.x + 50} cy="50" r="50" vector-effect="non-scaling-stroke" />
      ) : (
        <path d={p.glyph.d} transform={`translate(${p.x} 0)`} vector-effect="non-scaling-stroke" />
      ),
    )
  }
</svg>
