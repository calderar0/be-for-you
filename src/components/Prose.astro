---
// Página de texto simples (política de privacidade, 404).
import Base from '../layouts/Base.astro';
import type { Lang } from '../i18n/strings';

interface Props {
  lang: Lang;
  alternate: string;
  title: string;
  lead?: string;
  back: { href: string; label: string };
}

const { lang, alternate, title, lead, back } = Astro.props;
---

<Base lang={lang} alternate={alternate} title={`${title} | Be For You`}>
  <section class="prose-page tone" data-tone="light">
    <div class="wrap">
      <h1 class="section-title">{title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <div class="prose">
        <slot />
      </div>
      <a class="btn btn--ghost back" href={back.href}>{back.label}</a>
    </div>
  </section>
</Base>

<style>
  .prose-page {
    min-height: 80svh;
    padding-block: 160px var(--section);
  }

  .lead {
    margin-top: 20px;
    color: var(--fg-soft);
  }

  .prose {
    max-width: 42rem;
    margin-top: 48px;
  }

  .prose :global(h2) {
    margin: 2.2em 0 0.6em;
    font-size: var(--step-2);
    font-weight: 350;
    line-height: 1.2;
  }

  .prose :global(p),
  .prose :global(li) {
    color: var(--fg);
    margin-bottom: 1em;
  }

  .prose :global(ul) {
    list-style: disc;
    padding-left: 1.2em;
  }

  .prose :global(a) {
    text-underline-offset: 0.2em;
  }

  .back {
    margin-top: 48px;
  }
</style>
