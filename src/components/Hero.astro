---
import Orbs from './Orbs.astro';
import Lettering from './Lettering.astro';
import Signature from './Signature.astro';
import { t, type Lang } from '../i18n/strings';
import { whatsappLink } from '../data/site';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang);
---

<section class="hero tone" data-tone="light">
  <Orbs set="hero" />
  <div class="hero-grid wrap">
    <div class="hero-art">
      <h1 class="sr-only">{s.hero.title}</h1>
      <Signature mode="hero" class="hero-sig" />
      <Lettering />
    </div>

    <div class="hero-aside">
      <p class="hero-lead">{s.hero.lead}</p>
      <div class="hero-ctas">
        <a class="btn" href="#portfolio">{s.hero.primary}</a>
        <a class="btn btn--ghost" href={whatsappLink(s.hero.callMessage)} target="_blank" rel="noopener">
          {s.hero.secondary}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: grid;
    align-items: center;
    padding-block: 112px 56px;
    overflow: clip;
  }

  .hero-grid {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: end;
    gap: clamp(32px, 5vw, 88px);
  }

  .hero-art {
    position: relative;
    width: min(62vw, calc((100svh - 260px) * 1.23), 900px);
  }

  .hero-art :global(.lettering) {
    position: relative;
  }

  .hero-art :global(.hero-sig) {
    position: absolute;
    inset: 4% -8%;
  }

  .hero-aside {
    display: grid;
    gap: 36px;
    padding-bottom: 6%;
    max-width: 30rem;
  }

  .hero-lead {
    font-size: var(--step-1);
    font-weight: 350;
    line-height: 1.5;
    text-wrap: pretty;
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  @media (max-width: 1100px) {
    .hero {
      align-items: start;
    }

    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 40px;
    }

    .hero-art {
      width: min(100%, calc((100svh - 330px) * 1.23), 760px);
    }

    .hero-aside {
      padding-bottom: 0;
    }
  }

  @media (max-width: 640px) {
    .hero {
      padding-top: 96px;
    }

    .hero-art {
      width: 100%;
    }

    .hero-ctas .btn {
      flex: 1 1 100%;
    }
  }
</style>
