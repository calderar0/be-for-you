---
// Só aparece quando houver clientes ou depoimentos cadastrados em src/data/clients.ts.
import { t, type Lang } from '../i18n/strings';
import { clients, testimonials } from '../data/clients';
import { withBase } from '../lib/url';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang).clients;
---

{
  (clients.length > 0 || testimonials.length > 0) && (
    <section class="clients tone" data-tone="dark" aria-labelledby="clients-title">
      <div class="wrap">
        {clients.length > 0 && (
          <>
            <h2 class="c-title" id="clients-title">{s.title}</h2>
            <ul class="logos">
              {clients.map((c) => (
                <li>
                  <img src={withBase(c.logo)} alt={c.name} loading="lazy" />
                </li>
              ))}
            </ul>
          </>
        )}

        {testimonials.length > 0 && (
          <>
            <h2 class="c-title" id={clients.length ? undefined : 'clients-title'}>{s.testimonialsTitle}</h2>
            <ul class="quotes">
              {testimonials.map((q) => (
                <li>
                  <figure>
                    <blockquote>
                      <p>{q.quote[lang]}</p>
                    </blockquote>
                    <figcaption>
                      <span class="q-author">{q.author}</span>
                      <span class="q-role">{q.role[lang]}</span>
                    </figcaption>
                  </figure>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    </section>
  )
}

<style>
  .clients {
    padding-block: 0 var(--section);
  }

  .c-title {
    font-size: var(--step-2);
    font-weight: 300;
    margin-bottom: 40px;
  }

  .logos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
    margin-bottom: clamp(64px, 8vw, 120px);
  }

  .logos li {
    display: grid;
    place-items: center;
    aspect-ratio: 3 / 2;
    padding: 28px;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .logos img {
    max-height: 48px;
    width: auto;
    filter: brightness(0) invert(1);
    opacity: 0.85;
  }

  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: clamp(32px, 4vw, 64px);
  }

  blockquote p {
    font-size: var(--step-1);
    font-weight: 300;
    line-height: 1.5;
    text-wrap: pretty;
  }

  figcaption {
    display: grid;
    margin-top: 20px;
  }

  .q-role {
    color: var(--fg-soft);
    font-size: 0.95rem;
  }
</style>
