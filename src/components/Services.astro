---
import Orbs from './Orbs.astro';
// Serviços em duas metades: o que fazemos (Be) e o que você recebe (You).
// Entre as metades corre o fio da marca, que se desenha com o scroll e se cruza em cada serviço.
import { t, type Lang } from '../i18n/strings';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const s = t(lang).services;

// Ícones de traço fino, na ordem dos serviços: design, marketing digital, engenharia.
const icons = [
  ['M24 4C25 17 31 23 44 24 31 25 25 31 24 44 23 31 17 25 4 24 17 23 23 17 24 4Z'],
  ['M14 5h10a5 5 0 0 1 5 5v28a5 5 0 0 1-5 5H14a5 5 0 0 1-5-5V10a5 5 0 0 1 5-5Z', 'M16 18l7 6-7 6Z', 'M34 17a8 8 0 0 1 0 14', 'M38 13a12 12 0 0 1 0 22'],
  ['M17 14 7 24l10 10', 'M31 14l10 10-10 10', 'M27 10l-6 28'],
];
---

<section class="services tone" id="servicos" data-tone="light" aria-labelledby="services-title">
  <Orbs set="services" />
  <div class="wrap">
    <header class="section-head">
      <h2 class="section-title" id="services-title">{s.title}</h2>
      <p class="section-intro">{s.intro}</p>
    </header>

    <div class="halves" role="presentation">
      <p class="col-head">{s.colWe}</p>
      <span aria-hidden="true"></span>
      <p class="col-head">{s.colYou}</p>
    </div>

    <div class="rows-wrap">
      <svg class="axis" fill="none" aria-hidden="true">
        <path stroke="var(--agua)" pathLength="1"></path>
        <path stroke="var(--ameixa)" pathLength="1"></path>
      </svg>

      <ul class="rows">
        {
          s.items.map((item, i) => (
            <li class="row">
              <div class="we">
                <svg class="svc-icon" viewBox="0 0 48 48" fill="none" aria-hidden="true">
                  {icons[i]?.map((d) => (
                    <path d={d} pathLength="1" />
                  ))}
                </svg>
                <h3 class="svc-title">{item.title}</h3>
                <p class="svc-name">{item.name}</p>
                <p class="svc-desc">{item.desc}</p>
              </div>
              <svg class="knot" viewBox="0 0 64 28" fill="none" aria-hidden="true">
                <path class="loop-a" d="M32 14C26 24 14 26 8 22c-6-4-6-12 0-16 6-4 18-2 24 8Z" pathLength="1" />
                <path class="loop-b" d="M32 14C38 4 50 2 56 6c6 4 6 12 0 16-6 4-18 2-24-8Z" pathLength="1" />
              </svg>
              <div class="you-wrap">
                <p class="you-label">{s.colYou}</p>
                <ul class="you">
                  {item.deliverables.map((d) => (
                    <li>{d}</li>
                  ))}
                </ul>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .services {
    padding-block: var(--section);
  }

  .halves,
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 96px minmax(0, 1fr);
    column-gap: clamp(24px, 4vw, 64px);
  }

  .col-head {
    padding-bottom: 18px;
    color: var(--fg-soft);
    font-size: var(--step-0);
  }

  .rows-wrap {
    position: relative;
  }

  /* Fio duplo entre as metades: uma corrente de ∞ que se desenha com o scroll. */
  .axis {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
    stroke-width: 1.5px;
    stroke-linecap: round;
  }

  .axis path {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .rows {
    border-top: 1px solid var(--line);
  }

  .row {
    padding-block: clamp(36px, 5vw, 64px);
    border-bottom: 1px solid var(--line);
    align-items: start;
    transition: opacity 0.5s var(--ease);
  }

  .svc-icon {
    width: 52px;
    height: 52px;
    margin-bottom: 24px;
    color: var(--ameixa);
    stroke: currentColor;
    stroke-width: 1.5px;
    stroke-linecap: round;
    stroke-linejoin: round;
    overflow: visible;
  }

  .svc-icon path {
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .svc-title {
    font-size: var(--step-3);
    font-weight: 300;
    line-height: 1.05;
    letter-spacing: -0.015em;
    text-wrap: balance;
    transition: transform 0.6s var(--ease);
  }

  .svc-name {
    margin-top: 12px;
    color: var(--accent);
    font-size: var(--step-0);
    font-weight: 450;
  }

  .svc-desc {
    margin-top: 16px;
    max-width: 30rem;
    color: var(--fg-soft);
    text-wrap: pretty;
  }

  /* O infinito da marca, na altura do título de cada serviço (abaixo do ícone de 52px + 24px). */
  .knot {
    position: relative;
    width: 92px;
    margin-top: calc(76px + 0.55em);
    padding: 6px 0;
    justify-self: center;
    overflow: visible;
    /* No desktop o fio contínuo ocupa este lugar; o nó só marca a altura do título. */
    visibility: hidden;
    stroke-width: 1.5px;
    stroke-linejoin: round;
  }

  .knot path {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    transition:
      stroke-dashoffset 1.2s var(--ease),
      transform 0.6s var(--ease);
  }

  .loop-a {
    stroke: var(--agua);
  }

  .loop-b {
    stroke: var(--ameixa);
    transition-delay: 0.15s;
  }

  .row:global(.is-in) .knot path {
    stroke-dashoffset: 0;
  }

  .you-label {
    display: none;
    margin-bottom: 12px;
    color: var(--fg-soft);
  }

  .you {
    display: grid;
    padding-top: 0.35em;
  }

  .you li {
    padding-block: 12px;
    border-bottom: 1px solid var(--line);
    font-size: var(--step-1);
    font-weight: 350;
    line-height: 1.35;
    transition:
      transform 0.6s var(--ease),
      border-color 0.5s var(--ease);
  }

  .you li:first-child {
    padding-top: 0;
  }

  .you li:last-child {
    border-bottom: 0;
  }

  @media (hover: hover) and (min-width: 821px) {
    .rows:global(.has-active) .row {
      opacity: 0.45;
    }

    .rows .row:global(.is-active) {
      opacity: 1;
    }

    .row:global(.is-active) .svc-title {
      transform: translateX(8px);
    }

    .row:global(.is-active) .loop-a {
      transform: translateX(-4px);
    }

    .row:global(.is-active) .loop-b {
      transform: translateX(4px);
    }

    /* O ícone se redesenha quando o serviço é destacado. */
    .row:global(.is-active) .svc-icon path {
      animation: icon-draw 1s var(--ease) both;
    }

    .row:global(.is-active) .svc-icon path:nth-child(2) {
      animation-delay: 0.1s;
    }

    .row:global(.is-active) .svc-icon path:nth-child(3) {
      animation-delay: 0.2s;
    }

    .row:global(.is-active) .svc-icon path:nth-child(4) {
      animation-delay: 0.3s;
    }

    .row:global(.is-active) .you li {
      transform: translateX(-6px);
      border-color: color-mix(in srgb, var(--ameixa) 40%, transparent);
    }

    /* Escalonado: os itens entregues respondem um após o outro. */
    .row:global(.is-active) .you li:nth-child(2) {
      transition-delay: 0.04s;
    }
    .row:global(.is-active) .you li:nth-child(3) {
      transition-delay: 0.08s;
    }
    .row:global(.is-active) .you li:nth-child(4) {
      transition-delay: 0.12s;
    }
    .row:global(.is-active) .you li:nth-child(5) {
      transition-delay: 0.16s;
    }
  }

  @media (max-width: 820px) {
    .halves,
    .axis {
      display: none;
    }

    .row {
      grid-template-columns: minmax(0, 1fr);
      row-gap: 28px;
    }

    .knot {
      margin-top: 0;
      justify-self: start;
      visibility: visible;
    }

    .you-label {
      display: block;
    }

    .you li {
      font-size: var(--step-0);
    }
  }

  @keyframes icon-draw {
    from {
      stroke-dashoffset: 1;
    }
    to {
      stroke-dashoffset: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .knot path {
      stroke-dashoffset: 0;
    }

    .svc-icon path {
      animation: none !important;
    }

    .svc-title,
    .you li {
      transition: none;
    }
  }
</style>

<script>
  import { initServicesAxis } from '../scripts/services-axis';
  initServicesAxis();
</script>
