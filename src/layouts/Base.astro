---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Consent from '../components/Consent.astro';
import { t, type Lang } from '../i18n/strings';
import { site } from '../data/site';
import { withBase } from '../lib/url';

interface Props {
  lang: Lang;
  // Endereço equivalente no outro idioma.
  alternate: string;
  title?: string;
  description?: string;
}

const { lang, alternate, title, description } = Astro.props;
const s = t(lang);
const pageTitle = title ?? s.meta.title;
const pageDesc = description ?? s.meta.description;
const canonical = new URL(Astro.url.pathname, Astro.site);
const altUrl = new URL(alternate, Astro.site);
const ptUrl = lang === 'pt' ? canonical : altUrl;
const enUrl = lang === 'en' ? canonical : altUrl;
const ogImage = new URL(withBase('/og.png'), Astro.site);
const dev = import.meta.env.DEV;
---

<!doctype html>
<html lang={s.htmlLang} data-signature={site.signature}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDesc} />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="pt-BR" href={ptUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={ptUrl} />
    <link rel="icon" href={withBase('/favicon.svg')} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <meta name="theme-color" content="#faf9fd" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Be For You" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDesc} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_BR' : 'en_US'} />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: 'Be For You',
      url: new URL(withBase('/'), Astro.site).href,
      logo: new URL(withBase('/brand/icone.svg'), Astro.site).href,
      email: site.email,
    })} />

    <script is:inline>
      // Marca que o JavaScript está ativo e aplica ?assinatura= antes da primeira pintura.
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var p = new URLSearchParams(location.search).get('assinatura');
        if (p === 'fio' || p === 'esferas') d.dataset.signature = p;
      })();
    </script>
  </head>
  <body id="top">
    <a class="skip-link" href="#main">{s.skip}</a>
    <Header lang={lang} alternate={alternate} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} alternate={alternate} />
    <Consent lang={lang} />

    {
      dev && (
        <div class="sig-switch" role="group" aria-label="Assinatura (visível só em desenvolvimento)">
          <span>Assinatura</span>
          <a href="?assinatura=esferas">esferas</a>
          <a href="?assinatura=fio">fio</a>
        </div>
      )
    }

    <script>
      import { initSpheres } from '../scripts/spheres';
      import { initThreads } from '../scripts/threads';
      initSpheres();
      initThreads();
    </script>
  </body>
</html>

<style is:global>
  .sig-switch {
    position: fixed;
    left: 16px;
    bottom: 16px;
    z-index: 70;
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 6px 6px 6px 14px;
    border-radius: 999px;
    background: #15042a;
    color: #f3f0fa;
    font-size: 0.82rem;
  }

  .sig-switch span {
    margin-right: 6px;
    opacity: 0.7;
  }

  .sig-switch a {
    padding: 6px 12px;
    border-radius: 999px;
    text-decoration: none;
  }

  html[data-signature='esferas'] .sig-switch a[href$='esferas'],
  html[data-signature='fio'] .sig-switch a[href$='fio'] {
    background: #88bfbf;
    color: #15042a;
  }
</style>
